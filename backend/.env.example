APP_NAME=Adjacent
APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./data/app.db
MUSIC_LIBRARY_PATH=/path/to/music/library
FRONTEND_ORIGIN=http://localhost:5173

# Required. Signs auth cookies and stream tokens — generate your own:
#   openssl rand -hex 32
AUTH_SECRET_KEY=generate-your-own-with-openssl-rand-hex-32
