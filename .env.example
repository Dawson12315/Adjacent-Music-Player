# Copy to .env and fill in your own values. Never commit the .env file.

API_BASE_URL=http://Host_IP_Address:8000
FRONTEND_ORIGIN=http://Host_IP_Address:5173
MUSIC_LIBRARY_PATH_HOST=/your/host/music/path

# Contact email sent to MusicBrainz with API requests, per their etiquette policy.
MUSICBRAINZ_EMAIL=you@example.com

# Required. Signs auth cookies and stream tokens — generate your own:
#   openssl rand -hex 32
AUTH_SECRET_KEY=generate-your-own-with-openssl-rand-hex-32

# Deployment posture — leave as-is unless you are developing Adjacent itself.
APP_ENV=production
DEBUG=false

# Only set true when Adjacent is served over HTTPS. Secure cookies are never
# sent over plain-HTTP LAN addresses, which breaks login.
AUTH_COOKIE_SECURE=false
