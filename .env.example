# Copy to .env and fill in your own values. Never commit the .env file.

API_BASE_URL=http://Host_IP_Address:8000
FRONTEND_ORIGIN=http://Host_IP_Address:5173
MUSIC_LIBRARY_PATH_HOST=/your/host/music/path

# Contact email sent to MusicBrainz with API requests, per their etiquette policy.
MUSICBRAINZ_EMAIL=you@example.com

# Required. Signs auth cookies and stream tokens — generate your own:
#   openssl rand -hex 32
AUTH_SECRET_KEY=generate-your-own-with-openssl-rand-hex-32

# Deployment posture — leave as-is unless you are developing Adjacent itself.
APP_ENV=production
DEBUG=false

# Only set true when Adjacent is served over HTTPS. Secure cookies are never
# sent over plain-HTTP LAN addresses, which breaks login.
AUTH_COOKIE_SECURE=false

# Only needed for multi-user mode (docker compose --profile postgres up -d).
# This is the password you will type into Settings → Server when migrating.
# Generate one: openssl rand -hex 24
POSTGRES_PASSWORD=choose-a-database-password

# --- Internet exposure only (see "Exposing Adjacent to the internet") -------
# Address of the reverse proxy in front of Adjacent, so forwarded client IPs
# are trusted from it and only it. Leave empty for direct/LAN access.
# Never "*": that lets anyone spoof their address past the rate limiter.
FORWARDED_ALLOW_IPS=

# Optional shared secret required to create the first admin account. Set this
# before a brand-new install is reachable from the internet, otherwise the
# first visitor to an admin-less instance can claim it.
# Generate one: openssl rand -hex 16
SETUP_TOKEN=
